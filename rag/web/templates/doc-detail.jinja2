{% extends "base.jinja2" %}
{% block title %}文档详情 - IQA{% endblock %}

{% block content %}
<div class="page-content" id="doc-detail-page" data-doc-id="{{ doc.doc_id if doc else '' }}">
  <div class="doc-header">
    <a class="back-link" href="/knowledge{% if backCollection %}?collection={{ backCollection }}{% endif %}">← 返回知识库</a>
    <div class="doc-header-main" data-piece="doc_header">
      {% include "partials/doc_detail/doc_header.jinja2" %}
    </div>
    <div class="doc-header-actions">
      {% if doc and doc.status != 'deleted' %}
      <button class="btn btn-secondary btn-sm" data-doc-op="reingest"
              title="按当前解析口径重跑这篇文档：沿用原文档，覆盖更新全文索引/向量库/元数据，不会产生新文档或重复块">重解析</button>
      <button class="btn btn-secondary btn-sm" data-doc-op="download"
              title="从对象存储下载上传时的原始文件">下载</button>
      <button class="btn btn-secondary btn-sm" data-doc-op="delete"
              title="移入回收站：列表里不再显示、不参与检索，可在回收站恢复或彻底删除">删除</button>
      {% elif doc %}
      <button class="btn btn-secondary btn-sm" data-doc-op="restore"
              title="放回文档列表，状态还原成删除前的状态（不重新解析）">恢复</button>
      <button class="btn btn-danger btn-sm" data-doc-op="permanent"
              title="彻底删除：清理向量库、全文索引、图谱、对象存储与元数据中的全部内容，不可恢复">彻底删除</button>
      {% endif %}
    </div>
  </div>

  <div class="doc-layout">
    <aside class="doc-side-panel">
      <div class="card"><div class="card-body" data-piece="doc_attrs">
        {% include "partials/doc_detail/doc_attrs.jinja2" %}
      </div></div>
    </aside>
    <div>
      <div class="tabs knowledge-tabs" style="margin-bottom:12px">
        <button class="tab active" data-dtab="preview">内容预览</button>
        <button class="tab" data-dtab="chunks">分块</button>
      </div>
      <div data-dtab-panel="preview">
        <div class="preview-pane" data-piece="preview_pane">
          {% include "partials/doc_detail/preview_pane.jinja2" %}
        </div>
      </div>
      <div data-dtab-panel="chunks" class="hidden">
        <div data-piece="chunks_container">
          {% include "partials/doc_detail/chunks_container.jinja2" %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/doc-detail.js"></script>
{% endblock %}
