{% macro status_badge(status) %}
  {% set cls = {'done':'success','failed':'error','partial':'warning','deleted':'muted',
                'queued':'info','parsing':'info','embedding':'info','uploading':'info',
                'indexing':'info','retrying':'warning','superseded':'muted'} %}
  {% set label = {'done':'已完成','failed':'失败','partial':'部分完成','deleted':'回收站',
                  'queued':'排队中','parsing':'解析中','embedding':'向量化','uploading':'上传中',
                  'indexing':'索引中','retrying':'重试中','superseded':'已覆盖'} %}
  <span class="badge badge-{{ cls.get(status, 'muted') }}">{{ label.get(status, status) }}</span>
{% endmacro %}

{% macro fmt_size(n) %}
  {%- if n is none -%}—
  {%- elif n < 1024 -%}{{ n }} B
  {%- elif n < 1048576 -%}{{ '%.1f' | format(n / 1024) }} KB
  {%- else -%}{{ '%.1f' | format(n / 1048576) }} MB{%- endif -%}
{% endmacro %}

{% macro docs_table(data, archived) %}
  {% if data is none %}
    <div class="table-empty">加载中…</div>
  {% elif not data.docs %}
    <div class="table-empty">{{ '回收站为空' if archived else '暂无文档，点击上方按钮上传' }}</div>
  {% else %}
  <table class="data-table">
    <thead><tr>
      <th>文档</th><th>集合</th><th>状态</th><th>分块</th><th>大小</th><th>上传时间</th><th style="width:220px">操作</th>
    </tr></thead>
    <tbody>
      {% for doc in data.docs %}
      <tr data-doc-id="{{ doc.doc_id }}">
        <td>
          <div class="doc-title-main">{{ doc.filename }}</div>
          <div class="doc-title-sub">{{ doc.file_type or '' }}{% if doc.error %} · <span class="text-error">{{ doc.error[:60] }}</span>{% endif %}</div>
        </td>
        <td>{{ doc.collection }}</td>
        <td>{{ status_badge(doc.status) }}</td>
        <td>{{ doc.chunk_count if doc.chunk_count is not none else '—' }}</td>
        <td>{{ fmt_size(doc.file_size) }}</td>
        <td>{{ (doc.created_at or '')[:16].replace('T', ' ') }}</td>
        <td>
          {% if archived %}
          <button class="btn btn-ghost btn-xs" data-doc-action="restore" data-doc-id="{{ doc.doc_id }}">恢复</button>
          <button class="btn btn-ghost btn-xs text-error" data-doc-action="permanent"
                  data-doc-id="{{ doc.doc_id }}" data-filename="{{ doc.filename }}">永久删除</button>
          {% else %}
          <button class="btn btn-ghost btn-xs" data-doc-action="open" data-doc-id="{{ doc.doc_id }}">详情</button>
          <button class="btn btn-ghost btn-xs" data-doc-action="reingest" data-doc-id="{{ doc.doc_id }}">重建</button>
          <button class="btn btn-ghost btn-xs" data-doc-action="download"
                  data-doc-id="{{ doc.doc_id }}" data-filename="{{ doc.filename }}">下载</button>
          <button class="btn btn-ghost btn-xs text-error" data-doc-action="delete"
                  data-doc-id="{{ doc.doc_id }}" data-filename="{{ doc.filename }}">删除</button>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="table-pagination">
    <button class="btn btn-secondary btn-xs js-doc-page" data-page="{{ data.page - 1 }}"
            {% if data.page <= 1 %}disabled{% endif %}>上一页</button>
    <span class="page-info">第 {{ data.page }} 页 · 共 {{ data.total }} 条</span>
    <button class="btn btn-secondary btn-xs js-doc-page" data-page="{{ data.page + 1 }}"
            {% if not data.hasMore %}disabled{% endif %}>下一页</button>
  </div>
  {% endif %}
{% endmacro %}
