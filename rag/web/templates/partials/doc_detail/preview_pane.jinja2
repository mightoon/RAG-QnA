{% set d = data if data is defined else none %}
{% set doc = d.doc if d and d.doc is defined else (doc if doc is defined else none) %}
{% set elements = d.elements if d and d.elements is defined else none %}
{% set outline = d.outline if d and d.outline is defined else none %}
{% if not doc %}
  <div class="preview-empty">加载中…</div>
{% elif doc.status in ('queued','parsing','embedding','uploading','indexing') %}
  <div class="preview-empty">文档处理中（{{ doc.status }}），稍后刷新查看</div>
{% elif not elements %}
  <div class="preview-empty">暂无可预览内容</div>
{% else %}
  {% if outline %}
  <div class="pv-outline">
    <div class="pv-outline-title">大纲</div>
    <ul>
      {% for o in outline[:30] %}<li class="toc-l{{ o.level }}">{{ o.title }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% set ns = namespace(last_page=0) %}
  {% for el in elements[:300] %}
    {% if el.page and el.page != ns.last_page %}
      {% set ns.last_page = el.page %}
      {# 页标记显示**区间**：这里展示的是"父块 = 一整节"，一节常常跨页
         （实测 5 页的文档里有 4 节跨页）。只显示起始页会让用户以为"分页标错了"。
         区间 = "从这一页开始的内容，一直排到第几页"，由后端按组算好（page_span_end）。 #}
      <div class="pv-page-mark">— 第 {{ el.page }}{% if el.page_span_end and el.page_span_end > el.page %}–{{ el.page_span_end }}{% endif %} 页 —</div>
    {% endif %}
    {% if el.type == 'heading' %}
      <div class="pv-element pv-title t2">{{ el.text }}</div>
    {% elif el.type == 'table' and el.raw_data %}
      <div class="pv-table-wrap"><table class="pv-table">
        {% if el.raw_data.headers %}<thead><tr>
          {% for h in el.raw_data.headers %}<th>{{ h }}</th>{% endfor %}
        </tr></thead>{% endif %}
        <tbody>
          {% for row in el.raw_data.rows[:30] %}<tr>
            {% for c in row %}<td>{{ c }}</td>{% endfor %}
          </tr>{% endfor %}
        </tbody>
      </table></div>
    {% else %}
      <div class="pv-element">{{ el.text[:500] }}</div>
    {% endif %}
  {% endfor %}
{% endif %}
